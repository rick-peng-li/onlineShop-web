{
  "name": "onlineshop-web",
  "version": "1.0.0",
  "description": "sam's accurium online shop (MERN + Vite + Ant Design)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "data:import": "npm run data:import --prefix server",
    "data:destroy": "npm run data:destroy --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
